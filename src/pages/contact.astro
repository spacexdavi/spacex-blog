---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="联系" headerMode="solid">
  <section class="page-intro">
    <p class="eyebrow" data-site-edit="contact-page-eyebrow">Contact / Open channel</p>
    <h1 data-site-edit="contact-page-title">Contact</h1>
    <div class="page-intro__bottom">
      <strong data-site-edit="contact-page-count">One open channel</strong>
      <span data-site-edit="contact-page-description">如果你想交流项目、文章或新的想法，目前可以通过 GitHub 找到我。</span>
    </div>
  </section>

  <section class="contact-links" aria-label="联系方式">
    <a class="contact-link" href="https://github.com/spacexdavi" target="_blank" rel="noreferrer">
      <span data-site-edit="contact-github-index">01</span>
      <strong data-site-edit="contact-github-title">GitHub</strong>
      <span data-site-edit="contact-github-handle">@spacexdavi ↗</span>
    </a>
  </section>
</BaseLayout>
