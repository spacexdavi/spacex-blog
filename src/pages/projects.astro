---
import BaseLayout from "../layouts/BaseLayout.astro";
import siteLayout from "../data/site-layout.json";
import { cloneProjects } from "../lib/site-content";

const projects = cloneProjects(siteLayout.projects);
---

<BaseLayout title="项目" headerMode="solid">
  <section class="page-intro">
    <p class="eyebrow" data-site-edit="projects-page-eyebrow">Selected projects / Ongoing</p>
    <h1 data-site-edit="projects-page-title">Projects</h1>
    <div class="page-intro__bottom">
      <strong data-site-collection-count="projects">{String(projects.length).padStart(2, "0")} Projects</strong>
      <span data-site-edit="projects-page-description">围绕写作、发布和数字体验持续进行的个人项目。它们并非终点，而是仍在更新的工作现场。</span>
    </div>
  </section>

  <section class="manifesto" aria-label="项目列表" data-site-collection="projects">
    {
      projects.map((project, index) => {
        const Row = project.url ? "a" : "div";
        return (
          <Row
            class:list={["manifesto-row", { "manifesto-row--link": Boolean(project.url) }]}
            href={project.url || undefined}
            target={project.url ? "_blank" : undefined}
            rel={project.url ? "noreferrer" : undefined}
            data-site-project-id={project.id}
          >
            <span data-project-index>{String(index + 1).padStart(2, "0")}</span>
            <h2 data-project-title>{project.title}</h2>
            <p data-project-description>{project.description}</p>
          </Row>
        );
      })
    }
  </section>
</BaseLayout>
